{
  "appId": "com.xianma.ai-studio.desktop",
  "productName": "XMAI Studio",
  "buildVersion": "2.3.0.1",
  "icon": "build/icon.png",
  "afterPack": "scripts/after-pack.js",
  "directories": {
    "output": "dist-2.3.0.1"
  },
  "files": [
    "electron/**/*",
    "renderer/**/*"
  ],
  "extraResources": [
    {
      "from": "build/runtime-archive",
      "to": "runtime-archive",
      "filter": ["**/*"]
    },
    {
      "from": "build/runtime-tools",
      "to": "runtime-tools",
      "filter": ["**/*"]
    },
    {
      "from": "build/node-runtime/node-v24.18.0-win-x64",
      "to": "node-runtime",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "build/icon.ico"
  }
}
